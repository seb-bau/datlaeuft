diff -ruN a/app/templates/admin/material_movements.html b/app/templates/admin/material_movements.html
--- a/app/templates/admin/material_movements.html	1970-01-01 00:00:00.000000000 +0000
+++ b/app/templates/admin/material_movements.html	2026-07-02 09:57:05.107190635 +0000
@@ -0,0 +1,107 @@
+{% extends "base.html" %}
+{% block title %}Materialprüfung{% endblock %}
+{% block content %}
+<h1 class="h3 mb-4">Materialprüfung</h1>
+<div class="card shadow-sm mb-3">
+  <div class="card-body">
+    <form method="get" class="row g-3 align-items-end">
+      <div class="col-md-3">
+        <label class="form-label">Suche</label>
+        <input class="form-control" name="q" value="{{ search_text or '' }}" placeholder="Artikel, Auftrag, Position, Benutzer">
+      </div>
+      <div class="col-md-2">
+        <label class="form-label">Status</label>
+        <select class="form-select" name="status">
+          <option value="needs_review" {% if status_filter == "needs_review" %}selected{% endif %}>Zu prüfen</option>
+          <option value="ok" {% if status_filter == "ok" %}selected{% endif %}>OK</option>
+          <option value="approved" {% if status_filter == "approved" %}selected{% endif %}>Freigegeben</option>
+          <option value="rejected" {% if status_filter == "rejected" %}selected{% endif %}>Abgelehnt</option>
+          <option value="all" {% if status_filter == "all" %}selected{% endif %}>Alle</option>
+        </select>
+      </div>
+      <div class="col-md-2">
+        <label class="form-label">Ampel</label>
+        <select class="form-select" name="review_level">
+          <option value="" {% if not review_level_filter %}selected{% endif %}>Alle</option>
+          <option value="red" {% if review_level_filter == "red" %}selected{% endif %}>Rot</option>
+          <option value="yellow" {% if review_level_filter == "yellow" %}selected{% endif %}>Gelb</option>
+          <option value="green" {% if review_level_filter == "green" %}selected{% endif %}>Grün</option>
+        </select>
+      </div>
+      <div class="col-md-2">
+        <label class="form-label">Quelle</label>
+        <select class="form-select" name="source">
+          <option value="" {% if not source_filter %}selected{% endif %}>Alle</option>
+          {% for source in material_sources %}
+          <option value="{{ source.value }}" {% if source_filter == source.value %}selected{% endif %}>{{ source.value }}</option>
+          {% endfor %}
+        </select>
+      </div>
+      <div class="col-md-2 d-grid">
+        <button class="btn btn-primary" type="submit">Filtern</button>
+      </div>
+      <div class="col-md-1 d-grid">
+        <a class="btn btn-outline-secondary" href="{{ url_for('admin.material_movements') }}">Reset</a>
+      </div>
+    </form>
+  </div>
+</div>
+<div class="card shadow-sm">
+  <div class="card-body">
+    <table class="table table-striped datatable">
+      <thead>
+        <tr>
+          <th>Zeitpunkt</th>
+          <th>Artikel</th>
+          <th>Menge</th>
+          <th>Auftrag</th>
+          <th>Position</th>
+          <th>Quelle</th>
+          <th>Nutzung</th>
+          <th>Ampel</th>
+          <th>Status</th>
+          <th>Benutzer</th>
+          <th>Grund / Notiz</th>
+          <th></th>
+        </tr>
+      </thead>
+      <tbody>
+        {% for item in items %}
+        <tr>
+          <td>{{ item.occurred_at.strftime("%d.%m.%Y %H:%M") }}</td>
+          <td>{{ item.item.name }}<br><span class="text-muted small">{{ item.item.item_number }}</span></td>
+          <td>{{ item.quantity }} {{ item.item.unit }}</td>
+          <td>{{ item.commission.erp_id if item.commission else "" }}</td>
+          <td>{{ item.task_template.title if item.task_template else "" }}</td>
+          <td>{{ item.source }}</td>
+          <td>{{ item.usage_status }}</td>
+          <td>
+            <span class="badge text-bg-{% if item.review_level == 'red' %}danger{% elif item.review_level == 'yellow' %}warning{% else %}success{% endif %}">{{ item.review_level }}</span>
+          </td>
+          <td>{{ item.review_status }}</td>
+          <td>{{ item.user.display_name if item.user else "" }}</td>
+          <td class="small">
+            {% if item.deviation_reason %}<div>{{ item.deviation_reason }}</div>{% endif %}
+            {% if item.note %}<div>{{ item.note }}</div>{% endif %}
+          </td>
+          <td class="text-end">
+            {% if item.review_status == "needs_review" %}
+            <div class="d-flex gap-2 justify-content-end">
+              <form method="post" action="{{ url_for('admin.material_movement_review', item_id=item.id, decision='approve') }}">
+                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
+                <button class="btn btn-sm btn-success" type="submit">Freigeben</button>
+              </form>
+              <form method="post" action="{{ url_for('admin.material_movement_review', item_id=item.id, decision='reject') }}">
+                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
+                <button class="btn btn-sm btn-outline-danger" type="submit">Ablehnen</button>
+              </form>
+            </div>
+            {% endif %}
+          </td>
+        </tr>
+        {% endfor %}
+      </tbody>
+    </table>
+  </div>
+</div>
+{% endblock %}
